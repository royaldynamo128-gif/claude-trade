{
  "strategy": "CTFuturesTrendStrategy",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": 20,
  "tradable_balance_ratio": 0.90,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "data_format_ohlcv": "feather",
  "liquidation_buffer": 0.10,
  "stoploss_on_exchange": true,
  "stoploss_price_type": "mark",
  "stoploss": -0.10,
  "trailing_stop": false,
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "AVAX/USDT:USDT",
      "DOGE/USDT:USDT",
      "LINK/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "leverage": 5.0,
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "disabled",
    "chat_id": "disabled"
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "disabled",
    "password": "disabled_password",
    "jwt_secret_key": "disabled_jwt_secret_key_1234567890123"
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": true,
    "train_period_days": 10,
    "backtest_period_days": 5,
    "live_retrain_hours": 0,
    "expiration_hours": 24,
    "identifier": "ct-futures-lgbm-v2",
    "feature_parameters": {
      "include_timeframes": ["5m", "1h"],
      "include_corr_pairlist": ["BTC/USDT:USDT", "ETH/USDT:USDT"],
      "label_period_candles": 24,
      "indicator_periods_candles": [10, 20],
      "include_shifted_candles": 2,
      "indicator_max_period_candles": 100,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_svm_to_remove_outliers": false,
      "DI_threshold": 1.0,
      "drop_outer_outliers": false
    },
    "data_kitchen": {
      "label_period_candles": 24
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 300,
      "learning_rate": 0.03,
      "max_depth": 6,
      "num_leaves": 31,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_samples": 20,
      "random_state": 42
    }
  },
  "bot_name": "ClaudeTrade-Backtest",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
