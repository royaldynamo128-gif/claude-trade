  ],
  "telegram": {
    "enabled": false,
    "token": "disabled",
    "chat_id": "disabled"
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "disabled",
    "password": "disabled_password",
    "jwt_secret_key": "disabled_jwt_secret_key_1234567890123"
