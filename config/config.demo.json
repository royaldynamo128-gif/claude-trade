{
  "strategy": "CTFuturesTrendStrategy",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": 20,
  "tradable_balance_ratio": 0.90,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.10,
  "stoploss_on_exchange": true,
  "stoploss_price_type": "mark",
  "stoploss": -0.10,
  "trailing_stop": false,
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      ".*/USDT:USDT"
    ],
    "pair_blacklist": [
      "(USDC|BUSD|TUSD|EUR|GBP)/USDT:USDT"
    ]
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "live_retrain_hours": 1,
    "expiration_hours": 24,
    "identifier": "ct-futures-lgbm-v3",
    "fit_live_predictions_candles": 300,
    "feature_parameters": {
      "include_timeframes": ["5m", "15m", "1h"],
      "include_corr_pairlist": ["BTC/USDT:USDT"],
      "label_period_candles": 24,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [10, 20],
      "indicator_max_period_candles": 200,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_svm_to_remove_outliers": true,
      "DI_threshold": 1.0,
      "noise_standard_deviation": 0.05,
      "drop_outer_outliers": false
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 1000,
      "learning_rate": 0.01,
      "num_leaves": 31,
      "min_data_in_leaf": 50,
      "feature_fraction": 0.8,
      "bagging_fraction": 0.8,
      "bagging_freq": 5,
      "early_stopping_rounds": 50,
      "random_state": 42
    }
  },
  "leverage": 5.0,
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 500,
      "sort_key": "quoteVolume",
      "min_value": 0,
      "refresh_period": 1800
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    },
    {
      "method": "PrecisionFilter"
    },
    {
      "method": "PriceFilter",
      "min_price": 0.0000001,
      "low_price_ratio": 0.002
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8088,
    "username": "freqtrade",
    "password": "freqtrade123",
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": [],
    "jwt_secret_key": "somethingRandomSomethingRandom123"
  },
  "initial_state": "running",
  "force_entry_enable": true,
  "internals": {
    "process_throttle_secs": 5
  }
}
