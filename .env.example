# Environment Variables Template
# Copy this file to .secrets and fill in your real values.
# .secrets is gitignored — never commit real credentials.

# --- Binance Demo (Futures Paper Trading) ---
# Get from: https://www.binance.com/en/my/settings/api-management (select "Demo")
BINANCE_DEMO_API_KEY=your_demo_key_here
BINANCE_DEMO_API_SECRET=your_demo_secret_here

# --- Binance Live (fill when ready to go live) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Freqtrade Web UI (FreqUI) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FREQTRADE_JWT_SECRET=replace_with_generated_secret
FREQTRADE_WS_TOKEN=replace_with_generated_token
FREQTRADE_UI_USER=admin
FREQTRADE_UI_PASSWORD=replace_with_strong_password
